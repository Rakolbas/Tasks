const numbers =[10,11,12];

let sum = 0;
let max = numbers[0];
const filteredNumbers = [];
for (let num of numbers) {
    sum += num;                  
    if (num > max) max = num;    
    if (num > 10) {
        filteredNumbers.push(num); 
    }
}
console.log("cумма э:", sum);
console.log("макс число:", max);
console.log("больше 10:", filteredNumbers);